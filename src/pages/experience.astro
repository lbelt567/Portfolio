---
import Layout from '../layouts/Layout.astro'
import { workHistory, earlierWorkHistory, education } from '../lib/experience'
---
<Layout title="Experience" description="Technical solutions, operations, and software engineering experience at SST Automation, Leather Corral, Salesforce, and Bank of America. Education at USC Viterbi and Claremont McKenna College.">
  <div class="wrap page-content" id="top"><header class="page-heading"><h1>Experience</h1><p>Enterprise engineering, practical automation, and a habit of building.</p></header><div class="full-experience">{workHistory.map(role => <article class="full-role reveal"><div><h2>{role.company}</h2><p>{role.title}</p><p>{role.location}</p><p class="secondary">{role.dateRange}</p></div><div><ul>{role.achievements.map(item => <li>{item}</li>)}</ul><div class="stack-list">{role.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div><section class="earlier-experience"><h2>Earlier experience</h2>{earlierWorkHistory.map(role => <article class="full-role reveal"><div><h3>{role.company}</h3><p>{role.title}</p><p>{role.location}</p><p class="secondary">{role.dateRange}</p></div><ul>{role.achievements.map(item => <li>{item}</li>)}</ul></article>)}</section><section class="education-detail reveal"><h2>Education</h2>{education.map(item => <article><h3>{item.school}</h3><p>{item.degree}</p><p>{item.dateRange}</p><p>{item.location}</p>{item.gpa && <p class="secondary">GPA {item.gpa}</p>}{item.coursework && <p class="coursework">Relevant coursework: {item.coursework.join(", ")}</p>}</article>)}</section></div>
</Layout>
