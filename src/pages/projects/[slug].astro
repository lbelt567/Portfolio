---
import Layout from '../../layouts/Layout.astro'
import { projects } from '../../lib/projects'
import { projectImage } from '../../lib/project-media'
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })) }
const { project, next } = Astro.props
const image = projectImage(project.heroImage)
---
<Layout title={project.title} description={project.subtitle} image={image}>
  <div class="wrap page-content" id="top">
    <header class="page-heading"><a href="/#projects" class="back-link">Back to projects</a><h1>{project.title}</h1><p>{project.subtitle}</p></header>
    <img class:list={["detail-hero", "reveal", { "research-photo": project.slug === "tauroi-technologies" }]} src={image} alt={project.slug === "tauroi-technologies" ? "Luis presenting the Tauroi Technologies trading research poster" : project.slug === "polymarket-sentinel" ? "Polymarket Sentinel system architecture diagram" : `${project.title} project`} width="1400" height="800" fetchpriority="high" />
    <div class="detail-meta"><p>{project.type.replace(' / ', ' & ')}</p><p>{project.dateRange}</p></div>
    <div class="metrics reveal">{project.metrics.map(metric => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
    <div class="case-intro"><section class="reveal"><h2>The problem</h2><p>{project.problem}</p></section><section class="reveal"><h2>What I built</h2><p>{project.solution}</p></section></div>
    <section class="case-section reveal"><h2>The outcome</h2><ul>{project.outcomes.map(outcome => <li>{outcome}</li>)}</ul></section>
    <section class="case-section reveal"><h2>Built with</h2><div><div class="stack-list">{project.stack.map(technology => <span>{technology}</span>)}</div>{project.liveNote && <p class="current-site-note">{project.liveNote}</p>}<div class="case-actions">{project.liveUrl && <a class="button" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Visit live site</a>}{project.githubUrl && <a class="button" href={project.githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>}<button class="chat-open text-link" hidden>Ask about this project</button></div></div></section>
    <a class="next-project" href={`/projects/${next.slug}`}><p>Next project</p><h2>{next.title}</h2></a>
  </div>
</Layout>
